# Server
SERVER_PORT=8001

# PostgreSQL
BUSINESS_DATABASE_URL=postgresql://insurance:insurance123@192.168.150.101:5432/insurance_biz

# JWT
# Keep this value consistent with agent-service JWT_SECRET.
JWT_ISSUER=hm-insurance
JWT_SECRET=change-me-in-dev
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Refresh token cookie
# Local HTTP development should keep secure=false.
# Use secure=true only when serving over HTTPS.
REFRESH_TOKEN_COOKIE_NAME=hm_refresh_token
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAMESITE=lax

# Workspace root for resolving local static/PDF files.
APP_WORKSPACE_ROOT=..
