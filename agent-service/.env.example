APP_PORT=8002
LOG_LEVEL=INFO
LOG_FORMAT=console

# 业务端地址(本机)
BUSINESS_SERVICE_URL=http://127.0.0.1:8001

# JWT (与 biz-service 保持一致，请换成强随机值)
JWT_SECRET=change-me-in-dev

# PostgreSQL (本机, 注意 asyncpg 需要 +asyncpg 后缀)
DATABASE_URL=postgresql+asyncpg://insurance:insurance123@127.0.0.1:5432/insurance_agent

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-v4-flash
MARKDOWN_OPTIMIZER_MODEL=deepseek-v4-flash

# MinerU (仅知识库解析时需要)
MINERU_TOKEN=your-mineru-token

# Milvus (本地文件模式 Milvus Lite，不需要 Docker)
MILVUS_DB_PATH=./data/milvus_local.db
MILVUS_COLLECTION=insurance_knowledge

# 本地模型 (放在项目 models 目录下)
EMBEDDING_MODEL=C:/path/to/models/bge-m3
RERANK_MODEL=C:/path/to/models/bge-reranker-v2-m3
# 重排默认关闭：CPU 推理较慢，有 GPU 再开 true
RERANK_ENABLE=false

# LangSmith 可观测性（可选）
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=hm-insurance
